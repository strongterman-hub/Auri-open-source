# Local development only. All credentials belong to your own deployment.
AURI_ENVIRONMENT=development
AURI_DATA_DIR=data
AURI_LLM_PROVIDER=echo
# To enable an actual model: set provider=openai-compatible and fill these.
# AURI_LLM_BASE_URL=https://your-model-provider.example/v1
# AURI_LLM_API_KEY=
# AURI_LLM_MODEL=your-tool-capable-model
# AURI_LLM_VISION_MODEL=your-vision-model

AURI_DEBUG_UI_ENABLED=false
AURI_AUTH_EMAIL_VERIFICATION_REQUIRED=false
AURI_BILLING_ENFORCEMENT_ENABLED=false
AURI_ALIPAY_ENABLED=false
AURI_PROACTIVE_ENABLED=false
# Optional continuity controls for proactive questions.
# AURI_PROACTIVE_CONTEXT_TAIL_MESSAGES=4
# AURI_PROACTIVE_CONTEXT_USER_EXCHANGES=12
# AURI_PROACTIVE_CONTEXT_CONTINUITY_HOURS=72
# AURI_PROACTIVE_CONTINUITY_CHECK_ENABLED=true
# AURI_PROACTIVE_CONTINUITY_CHECK_MAX_TOKENS=2048
# AURI_PROACTIVE_CONTINUITY_HOLD_SECONDS=7200
AURI_HEALTH_SYNC_ENABLED=false
AURI_WEATHER_ENABLED=false
AURI_TRENDING_ENABLED=false
AURI_WEB_SEARCH_PROVIDER=none
AURI_CHAT_REPLY_ENABLED=true
AURI_DEFAULT_TIMEZONE=Asia/Shanghai

# Optional: enable the local admin dashboard with a strong unique password.
# AURI_ADMIN_USERNAME=
# AURI_ADMIN_PASSWORD=
# See docs/CONFIGURATION.md before enabling public registration or integrations.
