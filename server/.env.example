# Local development only. All credentials belong to your own deployment.
AURI_ENVIRONMENT=development
AURI_DATA_DIR=data
AURI_LLM_PROVIDER=echo
# To enable an actual model: set provider=openai-compatible and fill these.
# AURI_LLM_BASE_URL=https://your-model-provider.example/v1
# AURI_LLM_API_KEY=
# AURI_LLM_MODEL=your-tool-capable-model
# AURI_LLM_VISION_MODEL=your-vision-model

AURI_DEBUG_UI_ENABLED=false
AURI_AUTH_EMAIL_VERIFICATION_REQUIRED=false
AURI_BILLING_ENFORCEMENT_ENABLED=false
AURI_ALIPAY_ENABLED=false
AURI_PROACTIVE_ENABLED=false
# Optional continuity controls for proactive questions.
# AURI_PROACTIVE_CONTEXT_TAIL_MESSAGES=4
# AURI_PROACTIVE_CONTEXT_USER_EXCHANGES=12
# AURI_PROACTIVE_CONTEXT_CONTINUITY_HOURS=72
# AURI_PROACTIVE_CONTINUITY_CHECK_ENABLED=true
# AURI_PROACTIVE_CONTINUITY_CHECK_MAX_TOKENS=2048
# AURI_PROACTIVE_CONTINUITY_HOLD_SECONDS=7200
# Optional personal sleep-window controls. Defaults are shown below.
# AURI_PROACTIVE_SLEEP_DETECTION_ENABLED=true
# AURI_PROACTIVE_SLEEP_STAGE_FRESHNESS_SECONDS=900
# AURI_PROACTIVE_PERSONAL_SLEEP_ENABLED=true
# AURI_PROACTIVE_PERSONAL_SLEEP_LOOKBACK_DAYS=28
# AURI_PROACTIVE_PERSONAL_SLEEP_MIN_NIGHTS=5
# AURI_PROACTIVE_PERSONAL_SLEEP_CONFIDENCE_THRESHOLD=0.55
# AURI_PROACTIVE_PERSONAL_SLEEP_WAKE_TAIL_MINUTES=30
# AURI_PROACTIVE_PERSONAL_SLEEP_END_EARLY_TOLERANCE_MINUTES=30
# AURI_PROACTIVE_PERSONAL_SLEEP_END_STABILITY_MINUTES=45
# AURI_PROACTIVE_PERSONAL_SLEEP_MAX_WINDOW_HOURS=14
# AURI_PROACTIVE_PERSONAL_SLEEP_AWAKE_LEASE_MINUTES=90
# AURI_PROACTIVE_PERSONAL_SLEEP_WAKE_DELIVERY_COOLDOWN_MINUTES=30
# AURI_PROACTIVE_PERSONAL_SLEEP_WAKE_OPPORTUNITY_TTL_MINUTES=360
AURI_HEALTH_SYNC_ENABLED=false
AURI_WEATHER_ENABLED=false
AURI_TRENDING_ENABLED=false
AURI_WEB_SEARCH_PROVIDER=none
AURI_CHAT_REPLY_ENABLED=true
AURI_CHAT_GROUNDING_CHECK_ENABLED=true
AURI_DEFAULT_TIMEZONE=Asia/Shanghai

# Optional: enable the local admin dashboard with a strong unique password.
# AURI_ADMIN_USERNAME=
# AURI_ADMIN_PASSWORD=
# See docs/CONFIGURATION.md before enabling public registration or integrations.

# Configurable persona and relationship behavior. Presets live in
# server/app/persona/presets; user selection is reserved for a later client release.
AURI_PERSONA_ENABLED=true
AURI_PERSONA_DEFAULT_PRESET=warm_friend
AURI_PERSONA_USER_SELECTION_ENABLED=false
AURI_PERSONA_CANARY_USER_IDS=
AURI_PERSONA_VERSION=v1

# High-frequency proactive behavior with relationship-first category quotas.
AURI_PROACTIVE_FREQUENCY_PRESET=high
AURI_PROACTIVE_DAILY_MESSAGE_LIMIT=24
AURI_PROACTIVE_HEALTH_DAILY_LIMIT=3
AURI_PROACTIVE_WEATHER_DAILY_LIMIT=2
AURI_PROACTIVE_EXPLORE_DAILY_LIMIT=6
AURI_PROACTIVE_CASUAL_CHECKIN_DAILY_LIMIT=4
AURI_PROACTIVE_SELF_SHARE_DAILY_LIMIT=4
AURI_PROACTIVE_MEMORY_RECALL_DAILY_LIMIT=3
AURI_PROACTIVE_GOAL_REMINDER_DAILY_LIMIT=4

# Friend-style reply length anchoring and open-loop question control.
AURI_CHAT_REPLY_STYLE_ANCHOR_ENABLED=true
AURI_CHAT_REPLY_SILENT_ENABLED=true
AURI_CHAT_OPEN_LOOP_TTL_HOURS=24
AURI_CHAT_OPEN_LOOP_IMPORTANT_TTL_HOURS=72

# Bounded local location history used by location/movement context.
AURI_LOCATION_HISTORY_LIMIT=1000
AURI_LOCATION_CONTEXT_MAX_POINTS=12
